# AI guard service — live mode configuration. Copy to .env and fill in
# after the phase-2 testnet deployment. NEVER commit a filled .env.
# Dry-run mode (guard.py --dry-run) needs none of this.

# Base Sepolia RPC endpoint (public RPC or your own provider URL)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployed contract addresses (Base Sepolia) — from the phase-2 deployment
MOCK_POOL_ADDRESS=0x0000000000000000000000000000000000000000
AI_SIGNAL_ADDRESS=0x0000000000000000000000000000000000000000

# Testnet signer wallet JSON (must be registered as a poster on AISignal).
# Default: ../evm-wallet.json relative to this service directory.
# WALLET_FILE=../evm-wallet.json

# Seconds the Reactive contract gives the AI to answer (its decisionWindow)
DECISION_WINDOW_SECONDS=120

# Event polling interval (seconds)
POLL_INTERVAL_SECONDS=2
